{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git switch -c *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git stash pop *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch -m *)",
      "Bash(git tag *)",
      "Bash(git commit --amend)",
      "Bash(git commit --amend *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git worktree *)",
      "Bash(gh pr *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git push * --force-with-lease)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(git filter-branch *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git push --no-verify *)",
      "Bash(git config --global *)",
      "Read(./.git/objects/**)",
      "Read(./.git/logs/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)"
    ]
  }
}
